{
  "description": "List indentation depth preservation in mixed content",
  "test_cases": [
    {
      "name": "Single-level list maintains depth=0",
      "items": [
        {"text": "Item 1", "depth": 0},
        {"text": "Item 2", "depth": 0}
      ],
      "expected_depths": [0, 0]
    },
    {
      "name": "Nested list maintains depth=1 for children",
      "items": [
        {"text": "Parent", "depth": 0},
        {"text": "Child", "depth": 1}
      ],
      "expected_depths": [0, 1]
    },
    {
      "name": "Deep nesting maintains depths 0-2",
      "items": [
        {"text": "Level 0", "depth": 0},
        {"text": "Level 1", "depth": 1},
        {"text": "Level 2", "depth": 2}
      ],
      "expected_depths": [0, 1, 2]
    },
    {
      "name": "Mixed order preserves list depths alongside paragraphs",
      "items": [
        {"text": "Paragraph", "type": "paragraph"},
        {"text": "List item", "depth": 0},
        {"text": "Nested child", "depth": 1},
        {"text": "Another paragraph", "type": "paragraph"}
      ],
      "expected_sequence": ["paragraph", "list", "list", "paragraph"]
    },
    {
      "name": "Multiple same-depth lists maintain depth",
      "items": [
        {"text": "List A Item 1", "depth": 0},
        {"text": "List A Item 2", "depth": 0},
        {"text": "List B Item 1", "depth": 0},
        {"text": "List B Item 2", "depth": 0}
      ],
      "expected_depths": [0, 0, 0, 0]
    }
  ]
}
