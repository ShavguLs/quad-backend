{
  "description": "Paragraph break detection from vertical gaps and punctuation",
  "test_cases": [
    {
      "name": "Large gap indicates paragraph break",
      "line_gap": 25.0,
      "body_size": 12.0,
      "prev_line_ends_with_punct": false,
      "indentation_change": 0.0,
      "expected": true
    },
    {
      "name": "Small gap is soft break",
      "line_gap": 5.0,
      "body_size": 12.0,
      "prev_line_ends_with_punct": false,
      "indentation_change": 0.0,
      "expected": false
    },
    {
      "name": "Punctuation with moderate gap is paragraph break",
      "line_gap": 15.0,
      "body_size": 12.0,
      "prev_line_ends_with_punct": true,
      "indentation_change": 0.0,
      "expected": true
    },
    {
      "name": "Punctuation with small gap is soft break",
      "line_gap": 5.0,
      "body_size": 12.0,
      "prev_line_ends_with_punct": true,
      "indentation_change": 0.0,
      "expected": false
    },
    {
      "name": "Indentation change with gap is paragraph break",
      "line_gap": 8.0,
      "body_size": 12.0,
      "prev_line_ends_with_punct": false,
      "indentation_change": 15.0,
      "expected": true
    }
  ]
}
